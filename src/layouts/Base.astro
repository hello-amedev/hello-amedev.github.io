---
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import LangRedirect from "../components/LangRedirect.astro";

interface Props {
	title: string;
	description?: string;
	current?: "hub" | "drivedam";
	lang?: "ja" | "en" | "zh";
	/** 他言語版の URL(存在するものだけ渡す。自分の言語は含めない) */
	alt?: Partial<Record<"ja" | "en" | "zh", string>>;
	/** 明度。dark を渡すと <html data-theme="dark"> が付き、暗いページ用の CSS が効く */
	theme?: "light" | "dark";
	/** ページ識別子。<html data-page> に出て、ページ専用 CSS のスコープになる */
	page?: string;
	/** true にすると共通ヘッダー・フッターを出さない(ページ側が自前で用意する時) */
	bare?: boolean;
	/** og:image を差し替える(未指定は ame_dev 共通の 1200×630) */
	ogImagePath?: string;
	ogImageWidth?: number;
	ogImageHeight?: number;
}

const {
	title,
	description = "Google Drive・Dropbox・Box・社内ファイルサーバーの共有フォルダで、そのまま使えるチーム向け画像管理アプリ Drive DAM をはじめ、小さなチームの道具をつくる ame_dev の公式サイトです。",
	current,
	lang = "ja",
	alt,
	theme = "light",
	page,
	bare = false,
	ogImagePath = "/assets/og-image.jpg",
	ogImageWidth = 1200,
	ogImageHeight = 630,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(ogImagePath, Astro.site);
const ogLocale = lang === "en" ? "en_US" : lang === "zh" ? "zh_TW" : "ja_JP";

const langUrls: Partial<Record<"ja" | "en" | "zh", URL>> = {};
if (alt) {
	langUrls[lang] = canonical;
	for (const [code, href] of Object.entries(alt) as ["ja" | "en" | "zh", string][]) {
		langUrls[code] = new URL(href, Astro.site);
	}
}
---

<!doctype html>
<html lang={lang === "zh" ? "zh-Hant" : lang} data-theme={theme} data-page={page}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{alt && <LangRedirect current={lang} alt={alt} />}
		<meta name="theme-color" content={theme === "dark" ? "#080B14" : "#F6F8FA"} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/favicon.svg" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{langUrls.ja && (
			<>
				{langUrls.ja && <link rel="alternate" hreflang="ja" href={langUrls.ja} />}
				{langUrls.en && <link rel="alternate" hreflang="en" href={langUrls.en} />}
				{langUrls.zh && <link rel="alternate" hreflang="zh-Hant" href={langUrls.zh} />}
				<link rel="alternate" hreflang="x-default" href={langUrls.ja} />
			</>
		)}
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content={String(ogImageWidth)} />
		<meta property="og:image:height" content={String(ogImageHeight)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="generator" content={Astro.generator} />
	</head>
	<body>
		{!bare && <SiteHeader current={current} lang={lang} alt={alt} />}
		<main>
			<slot />
		</main>
		{!bare && <SiteFooter lang={lang} />}
	</body>
</html>
