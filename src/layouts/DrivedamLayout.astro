---
// Drive DAM ランディング用の独立レイアウト。
// ハブ(/) と製品 LP はヘッダー含めデザインコードを分ける方針(2026-07-06 決定)。
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/noto-sans-jp/400.css";
import "@fontsource/noto-sans-jp/500.css";
import "@fontsource/noto-sans-jp/600.css";
import "@fontsource/noto-sans-jp/700.css";
import "../styles/drivedam.css";
import LangRedirect from "../components/LangRedirect.astro";

interface Props {
	title: string;
	description?: string;
	lang?: "ja" | "en";
	altHref?: string;
	store?: { url: string; price: string; currency: string; version: string };
}

const {
	title,
	lang = "ja",
	altHref,
	store,
	description = lang === "en"
		? "Digital asset management for small teams that works in place on your shared folders — Google Drive, Dropbox, Box, office file servers, or local folders. Manage tens of thousands of images together, safely and fast."
		: "Google Drive・Dropbox・Box・社内ファイルサーバーの共有フォルダで、そのまま使える中小チーム向けのデジタルアセット管理アプリ Drive DAM。数万枚の画像を、複数人で、安全かつ高速に管理できます。",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(
	lang === "en" ? "/drivedam/og-image-en.png" : "/drivedam/og-image.png",
	Astro.site,
);
const ogLocale = lang === "en" ? "en_US" : "ja_JP";
const featureList =
	lang === "en"
		? [
				"Fast thumbnail browsing and search for tens of thousands of images",
				"Organize with tags, color labels, favorites, usage permissions, and notes",
				"Share tags and thumbnails with your team through the shared folder",
				"Resize and crop exports with social media size presets",
				"View HEIC, camera RAW (NEF, CR2, ARW, DNG, and more), and PDF files",
			]
		: [
				"数万枚でも快適なサムネイル一覧と高速検索",
				"タグ・色ラベル・お気に入り・使用可否・メモで画像を整理",
				"タグとサムネイルを共有フォルダ経由でチームに共有",
				"リサイズ・トリミング書き出し(SNS サイズ等のプリセット対応)",
				"HEIC・カメラ RAW(NEF・CR2・ARW・DNG など)・PDF の表示",
			];
const jsonLd = store
	? {
			"@context": "https://schema.org",
			"@type": "SoftwareApplication",
			name: "Drive DAM",
			operatingSystem: "Windows 10, Windows 11",
			applicationCategory: "MultimediaApplication",
			description,
			image: ogImage.href,
			url: canonical.href,
			installUrl: store.url,
			softwareVersion: store.version,
			author: { "@type": "Organization", name: "ame_dev" },
			inLanguage: lang,
			offers: { "@type": "Offer", price: store.price, priceCurrency: store.currency },
			screenshot: new URL(
				lang === "en" ? "/drivedam/assets/hero-main-en.png" : "/drivedam/assets/hero-main.png",
				Astro.site,
			).href,
			featureList,
			sameAs: [store.url],
		}
	: undefined;
const jaHref = lang === "ja" ? Astro.url.pathname : altHref;
const enHref = lang === "en" ? Astro.url.pathname : altHref;
const jaUrl = altHref ? new URL(jaHref!, Astro.site) : undefined;
const enUrl = altHref ? new URL(enHref!, Astro.site) : undefined;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{altHref && <LangRedirect />}
		<meta name="theme-color" content="#F6F8FA" />
		<link rel="icon" type="image/png" sizes="32x32" href="/drivedam/favicon-32.png" />
		<link rel="apple-touch-icon" href="/drivedam/apple-touch-icon.png" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{altHref && (
			<>
				<link rel="alternate" hreflang="ja" href={jaUrl} />
				<link rel="alternate" hreflang="en" href={enUrl} />
				<link rel="alternate" hreflang="x-default" href={jaUrl} />
			</>
		)}
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="generator" content={Astro.generator} />
		{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
	</head>
	<body>
		<slot />
	</body>
</html>
