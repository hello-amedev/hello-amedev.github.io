---
import DrivedamLayout from "../../../layouts/DrivedamLayout.astro";
import StoreBadge from "../../../components/StoreBadge.astro";
import { latest } from "../../../data/releases";
const storeUrl = "https://apps.microsoft.com/detail/9P4L43W1XP7P?hl=en-us&gl=US";
// Version strings come from src/data/releases.ts — never hard-code them here
const verLabel = `v${latest.version} (${latest.date})`;
// FAQ (final copy 3.9, 6 items). Single source for the static list and FAQPage JSON-LD.
// Rendered statically so non-JS crawlers (AI bots) can read the content.
const faq: [string, string][] = [
["Are my image files modified?","No. Tags and notes are stored in a <code>_dam/</code> folder next to your images — the image files themselves are never altered."],
["What happens to my tags and notes if I uninstall Drive DAM?","Tags and notes live in <code>_dam</code> folders inside your local or shared folders, so they remain after uninstalling — your teammates keep working, unaffected. Reinstall and register the folder again, and you pick up right where you left off. With settings export and import, you can also restore registered folders and bookmarks."],
["Can people without access to the shared folder see our tags and notes?","No. Access permissions on the shared folder define exactly who can see the tags and notes."],
["Does it tag images automatically with AI?","No. Tags are applied by hand and refined together as a team. There is no automatic classification quietly reorganizing your library."],
["Is Mac supported?","Drive DAM is a Windows app; Mac is not supported at present. The generated thumbnails and settings files are visible in the shared folder, but Drive DAM itself will not run there. A Mac version may come in the future."],
["How do I completely remove the thumbnail and tag data?","Once no Drive DAM user has the folder registered, delete the <code>_dam</code> and <code>_dam_thumbs</code> folders. If there are many, search for folders with those names and delete them all."]
];
const stripTags = (s: string) => s.replace(/<[^>]+>/g, "");
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map(([q, a]) => ({
    "@type": "Question",
    name: stripTags(q),
    acceptedAnswer: { "@type": "Answer", text: stripTags(a) },
  })),
};
---

<DrivedamLayout
  title="Drive DAM — From tens of thousands of images to the one you need | DAM app for Windows"
  description="Digital asset management for small teams that works in place on your shared folders — Google Drive, Dropbox, Box, office file servers, or local folders. Manage tens of thousands of images together, safely and fast."
  lang="en"
  alt={{ ja: "/drivedam/", zh: "/zh/drivedam/" }}
  store={{ url: storeUrl, price: "19.99", currency: "USD", version: latest.version }}
>

<div class="progress" id="progress" aria-hidden="true"></div>

<header class="site-head" id="siteHead">
  <div class="head-in">
    <a class="brand" href="/en/drivedam/"><img src="/drivedam/assets/app-icon.png" alt="">Drive DAM</a>
    <nav class="head-nav" aria-label="In-page menu">
      <a href="#about">About</a>
      <a href="#traits">Highlights</a>
      <a href="#funcs">Features</a>
      <a href="#price">Download</a>
      <a href="#faq">FAQ</a>
    </nav>
    <a class="head-link" href={storeUrl} target="_blank" rel="noopener noreferrer">Get on Microsoft Store</a>
    <a class="head-lang" href="/drivedam/?lang=ja">日本語</a>
    <a class="head-lang" href="/zh/drivedam/?lang=zh">繁體中文</a>
    <button class="head-burger" id="headBurger" aria-label="Open menu" aria-expanded="false" aria-controls="headOverlay">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<div class="head-overlay" id="headOverlay" aria-hidden="true">
  <nav class="head-overlay-nav" aria-label="In-page menu (mobile)">
    <a href="#about">About</a>
    <a href="#traits">Highlights</a>
    <a href="#funcs">Features</a>
    <a href="#price">Download</a>
    <a href="#faq">FAQ</a>
    <a href="/drivedam/?lang=ja">日本語</a>
    <a href="/zh/drivedam/?lang=zh">繁體中文</a>
  </nav>
  <p class="head-overlay-foot"><a href={storeUrl} target="_blank" rel="noopener noreferrer">Now on the Microsoft Store</a></p>
</div>

<!-- ============ HERO ============ -->
<section class="hero" id="hero">
  <div class="hero-light" id="heroLight" aria-hidden="true"><div class="hl-a"></div><div class="hl-b"></div></div>
  <div class="wrap">
    <h1 class="hero-title">
      <span class="hl hl-1"><span class="hl-in">From tens of thousands of images</span></span>
      <span class="hl hl-2"><span class="hl-in">to the <em>one</em> you need.</span></span>
      <span class="hl hl-3"><span class="hl-in">On your own, or with your team.</span></span>
    </h1>
    <div class="hero-lead">
      <div class="hero-lead-in">
        <p class="hero-sub">Digital asset management that <strong style="display:inline-block">works in place</strong> — in local folders and cloud storage alike.<br>Organize, find, and use images together, right through your shared folders.</p>
        <div class="hero-cta">
          <StoreBadge href={storeUrl} eyebrow="Get it on" label="Microsoft Store" />
        </div>
        <p class="hero-note"><a class="ver-link" href="/en/drivedam/releases/">{verLabel}</a> · Windows 10 or later</p>
      </div>
    </div>
    <figure class="hero-stage" id="heroStage">
      <div class="frame" id="heroFrame">
        <img src="/drivedam/assets/hero-main-en.png" alt="The actual Drive DAM screen: folder tree on the left, thumbnail grid in the center, selection and editing panel on the right" width="2556" height="1595">
        <div class="gloss" aria-hidden="true"></div>
      </div>
    </figure>
  </div>
</section>

<!-- ============ ABOUT(ツール説明) ============ -->
<section class="about sec-pad" id="about">
  <div class="wrap">
    <div class="cap" data-cap>About Drive DAM</div>
    <div class="grid">
      <div class="about-copy">
        <h2 class="about-h" data-reveal>Image management built for<br>PR and marketing teams.</h2>
        <p class="about-body" data-reveal>Drive DAM works by creating a small thumbnail and settings file alongside every image in your storage — <strong>the foundation for smart, team-wide image management</strong>. Handle tens of thousands of images with multiple people, safely and at speed. Local folders are fully supported too.</p>
      </div>
      <figure class="about-fig" data-reveal>
        <svg class="draw" id="figSideBySide" viewBox="0 0 360 240" role="img" aria-label="For every image file, a thumbnail and a settings file (tags and notes) are created alongside it">
          <rect x="18" y="48" width="170" height="126" rx="6" style="--len:600"/>
          <circle cx="66" cy="88" r="14" style="--len:90"/>
          <polyline points="18,160 84,108 126,140 160,112 188,146" style="--len:230"/>
          <text x="18" y="202" font-size="12" fill="#8B887F" stroke="none" font-family="Inter,sans-serif" letter-spacing="1">photo.jpg</text>
          <rect class="blue" x="240" y="24" width="100" height="64" rx="6" style="--len:340"/>
          <circle class="blue" cx="268" cy="44" r="8" style="--len:52"/>
          <polyline class="blue" points="240,81 279,54 303,71 323,56 340,74" style="--len:130"/>
          <text x="240" y="108" font-size="12" fill="#8B887F" stroke="none" font-family="Inter,sans-serif" letter-spacing="1">thumbnail</text>
          <rect class="blue" x="240" y="124" width="100" height="64" rx="6" style="--len:340"/>
          <line class="blue" x1="256" y1="142" x2="324" y2="142" style="--len:68"/>
          <line class="blue" x1="256" y1="156" x2="312" y2="156" style="--len:56"/>
          <line class="blue" x1="256" y1="170" x2="318" y2="170" style="--len:62"/>
          <text x="240" y="208" font-size="12" fill="#8B887F" stroke="none" font-family="Inter,sans-serif" letter-spacing="1">tags + notes</text>
          <line class="soft" x1="196" y1="56" x2="232" y2="56" style="--len:36"/>
          <line class="soft" x1="196" y1="156" x2="232" y2="156" style="--len:36"/>
        </svg>
        <figcaption class="fig-cap">For each image, Drive DAM creates a thumbnail and settings file of just a dozen kilobytes or so. Loading these at startup is what makes browsing and search so fast — and your image files themselves are never touched.</figcaption>
      </figure>
    </div>
  </div>
</section>

