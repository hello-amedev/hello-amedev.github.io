---
import DrivedamLayout from "../../../layouts/DrivedamLayout.astro";
import StoreBadge from "../../../components/StoreBadge.astro";
import { latest } from "../../../data/releases";
const storeUrl = "https://apps.microsoft.com/detail/9P4L43W1XP7P?hl=zh-tw&gl=TW";
// 版本標示以 src/data/releases.ts 為主要來源，此處不直接寫死
const verLabel = `v${latest.version}(${latest.date})`;
// FAQ(確定文案 3.9・共 6 題)。為靜態渲染與 FAQPage 結構化資料的主要來源。
// 為了讓不執行 JS 的爬蟲(AI 系)也能看到內容，組裝在此處完成，而非交由 script 處理
const faq: [string, string][] = [
["圖片檔案會被更動嗎？","不會。標籤與備註會儲存在圖片所在資料夾內的 <code>_dam/</code> 中，不會更動圖片檔案本身。"],
["解除安裝 Drive DAM 後，標籤與備註會怎麼樣？","標籤與備註會儲存在本機或共用資料夾內的 <code>_dam</code> 資料夾中，因此即使解除安裝 Drive DAM，也會照樣保留，不會影響團隊成員的使用。重新安裝後只要再次登錄資料夾，就能以相同狀態繼續使用。此外，透過設定的匯出與匯入功能，也能還原資料夾的登錄狀態與書籤。"],
["沒有共用資料夾存取權限的人，也能看到標籤與備註嗎？","看不到。共用資料夾的存取權限，就是標籤與備註的共用範圍。"],
["會透過 AI 自動加上標籤嗎？","不會。標籤是以手動方式加上，並由團隊共同累積與共用。不會有自動分類擅自整理的情形。"],
["支援 Mac 嗎？","Drive DAM 是 Windows 專用應用程式，目前尚未支援 Mac。系統產生的縮圖與設定檔會出現在共用資料夾中，但無法在 Mac 上使用 Drive DAM。未來有可能推出 Mac 版本。"],
["要如何完全刪除縮圖與標籤資料？","請先確認已沒有任何 Drive DAM 使用者登錄該資料夾，再刪除 <code>_dam</code> 資料夾及 <code>_dam_thumbs</code> 資料夾。若資料夾數量較多，請搜尋同名資料夾並全部刪除。"]
];
const stripTags = (s: string) => s.replace(/<[^>]+>/g, "");
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map(([q, a]) => ({
    "@type": "Question",
    name: stripTags(q),
    acceptedAnswer: { "@type": "Answer", text: stripTags(a) },
  })),
};
---

<DrivedamLayout
  title="Drive DAM — 從數萬張圖片中，找到需要的那一張｜可在共用資料夾使用的圖片管理(DAM)應用程式"
  lang="zh"
  alt={{ ja: "/drivedam/", en: "/en/drivedam/" }}
  store={{ url: storeUrl, price: "679", currency: "TWD", version: latest.version }}
>

<div class="progress" id="progress" aria-hidden="true"></div>

<header class="site-head" id="siteHead">
  <div class="head-in">
    <a class="brand" href="/zh/drivedam/"><img src="/drivedam/assets/app-icon.png" alt="">Drive DAM</a>
    <nav class="head-nav" aria-label="頁內選單">
      <a href="#about">關於 Drive DAM</a>
      <a href="#traits">特色</a>
      <a href="#funcs">功能</a>
      <a href="#price">下載</a>
      <a href="#faq">FAQ</a>
    </nav>
    <a class="head-link" href={storeUrl} target="_blank" rel="noopener noreferrer">在 Microsoft Store 取得</a>
    <a class="head-lang" href="/drivedam/?lang=ja">日本語</a>
    <a class="head-lang" href="/en/drivedam/?lang=en">English</a>
    <button class="head-burger" id="headBurger" aria-label="開啟選單" aria-expanded="false" aria-controls="headOverlay">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<div class="head-overlay" id="headOverlay" aria-hidden="true">
  <nav class="head-overlay-nav" aria-label="頁內選單（行動版）">
    <a href="#about">關於 Drive DAM</a>
    <a href="#traits">特色</a>
    <a href="#funcs">功能</a>
    <a href="#price">下載</a>
    <a href="#faq">FAQ</a>
    <a href="/drivedam/?lang=ja">日本語</a>
    <a href="/en/drivedam/?lang=en">English</a>
  </nav>
  <p class="head-overlay-foot"><a href={storeUrl} target="_blank" rel="noopener noreferrer">已在 Microsoft Store 上架</a></p>
</div>

<!-- ============ HERO ============ -->
<section class="hero" id="hero">
  <div class="hero-light" id="heroLight" aria-hidden="true"><div class="hl-a"></div><div class="hl-b"></div></div>
  <div class="wrap">
    <h1 class="hero-title">
      <span class="hl hl-1"><span class="hl-in">從數萬張圖片中，</span></span>
      <span class="hl hl-2"><span class="hl-in">找到需要的<em>那一張</em>。</span></span>
      <span class="hl hl-3"><span class="hl-in">一個人也好，團隊也好。</span></span>
    </h1>
    <div class="hero-lead">
      <div class="hero-lead-in">
        <p class="hero-sub">無論是本機資料夾，還是線上儲存服務等，都能<strong style="display:inline-block">直接使用</strong>的數位資產管理。<br>透過共用資料夾，讓團隊的圖片管理與運用更有效率。</p>
        <div class="hero-cta">
          <StoreBadge href={storeUrl} eyebrow="在 Microsoft Store" label="立即取得" />
        </div>
        <p class="hero-note"><a class="ver-link" href="/zh/drivedam/releases/">{verLabel}</a>・支援 Windows 10 以上</p>
      </div>
    </div>
    <figure class="hero-stage" id="heroStage">
      <div class="frame" id="heroFrame">
        <img src="/drivedam/assets/hero-main-zh.png" alt="Drive DAM 的實際畫面。左側為資料夾樹狀結構，中央為縮圖列表，右側為選取／編輯面板" width="2556" height="1595">
        <div class="gloss" aria-hidden="true"></div>
      </div>
    </figure>
  </div>
</section>

<!-- ============ ABOUT(ツール説明) ============ -->
<section class="about sec-pad" id="about">
  <div class="wrap">
    <div class="cap" data-cap>關於 Drive DAM</div>
    <div class="grid">
      <div class="about-copy">
        <h2 class="about-h" data-reveal>專為公關與行銷打造的，<br>圖片管理工具。</h2>
        <p class="about-body" data-reveal>Drive DAM 會為每張圖片，在線上儲存空間內建立小型縮圖與設定檔，是一款<strong>讓團隊能聰明地管理與運用圖片</strong>的工具。即使是數萬張圖片，也能由多人安全且快速地管理，同時也支援在本機資料夾中使用。</p>
      </div>
      <figure class="about-fig" data-reveal>
        <svg class="draw" id="figSideBySide" viewBox="0 0 360 240" role="img" aria-label="每一張圖片檔案，都會在旁邊建立縮圖與設定檔（標籤、備註）兩個檔案">
          <rect x="18" y="48" width="170" height="126" rx="6" style="--len:600"/>
          <circle cx="66" cy="88" r="14" style="--len:90"/>
          <polyline points="18,160 84,108 126,140 160,112 188,146" style="--len:230"/>
