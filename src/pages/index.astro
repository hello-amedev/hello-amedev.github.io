---
import Base from "../layouts/Base.astro";

const products = [
	{
		name: "Drive DAM",
		tag: "チーム向け画像管理",
		desc: "Google Drive・Dropbox・Box・社内ファイルサーバー の共有フォルダで、そのまま使えるチーム向け画像管理アプリです。タグ・色・メモをメンバーで共有し、画像ファイルには手を加えません。",
		href: "/drivedam/",
		status: "available",
	},
];
---

<Base title="ame_dev — 小さなチームの道具をつくる" current="hub">
	<!-- ハブ・ヒーロー -->
	<section class="hub-hero">
		<div class="container">
			<span class="eyebrow eyebrow--code">ame_dev</span>
			<h1 class="hub-hero__title">小さなチームの仕事を、<br />すこし軽くする道具を。</h1>
			<p class="hub-hero__sub">
				ame_dev は、日々の業務にそっと馴染むアプリをつくっています。
				いまの使い方を大きく変えずに、できることを増やす——そんな道具を目指しています。
			</p>
			<a class="btn btn--primary" href="/drivedam/">Drive DAM を見る</a>
		</div>
	</section>

	<!-- 製品一覧 -->
	<section class="section" id="products">
		<div class="container">
			<div class="section-head">
				<span class="eyebrow eyebrow--code">製品</span>
				<h2 class="section-title">いま公開している道具</h2>
			</div>
			<div class="product-grid">
				{products.map((p) => (
					<a class="product-card" href={p.href}>
						<div class="product-card__top">
							<span class="product-card__mark">D</span>
							<span class="product-card__tag">{p.tag}</span>
						</div>
						<h3 class="product-card__name">{p.name}</h3>
						<p class="product-card__desc">{p.desc}</p>
						<span class="product-card__more">くわしく見る →</span>
					</a>
				))}
				<div class="product-card product-card--soon">
					<div class="product-card__top">
						<span class="product-card__mark product-card__mark--soon">+</span>
					</div>
					<h3 class="product-card__name product-card__name--soon">次の道具を準備中</h3>
					<p class="product-card__desc">
						新しいアプリを順次公開していきます。お知らせを希望される方はお問い合わせください。
					</p>
				</div>
			</div>
		</div>
	</section>
</Base>

<style>
	.hub-hero {
		background:
			radial-gradient(900px 420px at 85% -10%, var(--blue-soft), transparent 62%),
			linear-gradient(180deg, #ffffff, var(--blue-softer));
		padding-block: 96px 84px;
		text-align: center;
	}
	.hub-hero__title {
		font-size: clamp(2rem, 1.3rem + 3vw, 3.1rem);
		line-height: 1.3;
		margin-bottom: 24px;
	}
	.hub-hero__sub {
		max-width: 34em;
		margin: 0 auto 32px;
		color: var(--ink-muted);
		font-size: 1.08rem;
		line-height: 1.95;
	}

	.product-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
		gap: 24px;
	}
	.product-card {
		display: block;
		background: #fff;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		padding: 30px 28px;
		box-shadow: var(--shadow-sm);
		transition: transform 0.15s ease, box-shadow 0.2s ease, border-color 0.2s ease;
	}
	.product-card:hover {
		transform: translateY(-3px);
		box-shadow: var(--shadow);
		text-decoration: none;
		border-color: var(--border-strong);
	}
	.product-card__top {
		display: flex;
		align-items: center;
		gap: 14px;
		margin-bottom: 18px;
	}
	.product-card__mark {
		width: 44px;
		height: 44px;
		border-radius: 11px;
		background: linear-gradient(135deg, var(--blue), var(--blue-deep));
		color: #fff;
		display: grid;
		place-items: center;
		font-weight: 800;
		font-size: 1.3rem;
		box-shadow: var(--shadow-sm);
		flex: none;
	}
	.product-card__mark--soon {
		background: var(--blue-soft);
		color: var(--blue);
	}
	.product-card__tag {
		font-size: 0.82rem;
		font-weight: 700;
		color: var(--blue-deep);
		background: var(--blue-soft);
		padding: 4px 12px;
		border-radius: 999px;
	}
	.product-card__name {
		font-size: 1.3rem;
		margin-bottom: 10px;
	}
	.product-card__name--soon {
		color: var(--ink-muted);
	}
	.product-card__desc {
		color: var(--ink-muted);
		font-size: 0.95rem;
		margin-bottom: 16px;
	}
	.product-card__more {
		font-weight: 700;
		color: var(--blue-deep);
		font-size: 0.92rem;
	}
	.product-card--soon {
		border-style: dashed;
		box-shadow: none;
		cursor: default;
	}
	.product-card--soon:hover {
		transform: none;
		box-shadow: none;
		border-color: var(--border);
	}
</style>
