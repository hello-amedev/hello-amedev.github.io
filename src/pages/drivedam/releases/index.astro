---
import DrivedamLayout from "../../../layouts/DrivedamLayout.astro";
import { releases } from "../../../data/releases";
const storeUrl = "https://apps.microsoft.com/detail/9P4L43W1XP7P?hl=ja-jp&gl=JP";
---

<DrivedamLayout
  title="更新履歴 — Drive DAM"
  description="Drive DAM の更新履歴。Microsoft Store で公開した各バージョンの変更内容をまとめています。"
  altHref="/en/drivedam/releases/"
>

<header class="site-head is-solid" id="siteHead">
  <div class="head-in">
    <a class="brand" href="/drivedam/"><img src="/drivedam/assets/app-icon.png" alt="">Drive DAM</a>
    <nav class="head-nav" aria-label="製品ページのメニュー">
      <a href="/drivedam/#about">Drive DAM とは</a>
      <a href="/drivedam/#traits">特徴</a>
      <a href="/drivedam/#funcs">機能</a>
      <a href="/drivedam/#price">ダウンロード</a>
      <a href="/drivedam/#faq">FAQ</a>
    </nav>
    <a class="head-link" href={storeUrl} target="_blank" rel="noopener noreferrer">Microsoft Store で入手</a>
    <a class="head-lang" href="/en/drivedam/releases/?lang=en">EN</a>
    <button class="head-burger" id="headBurger" aria-label="メニューを開く" aria-expanded="false" aria-controls="headOverlay">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<div class="head-overlay" id="headOverlay" aria-hidden="true">
  <nav class="head-overlay-nav" aria-label="製品ページのメニュー(モバイル)">
    <a href="/drivedam/#about">Drive DAM とは</a>
    <a href="/drivedam/#traits">特徴</a>
    <a href="/drivedam/#funcs">機能</a>
    <a href="/drivedam/#price">ダウンロード</a>
    <a href="/drivedam/#faq">FAQ</a>
    <a href="/en/drivedam/releases/?lang=en">English</a>
  </nav>
  <p class="head-overlay-foot"><a href={storeUrl} target="_blank" rel="noopener noreferrer">Microsoft Store で公開中</a></p>
</div>

<!-- JS が動かない環境では reveal が発火せず本文が消えるため、その時だけ全部見せる -->
<noscript>
  <style>.cap,.rel-item,.rel-back{opacity:1;transform:none}</style>
</noscript>

<main class="rel-page">
  <div class="wrap">
    <div class="cap" data-cap>更新履歴</div>
    <h1 class="rel-h">Drive DAM の更新履歴</h1>
    <p class="rel-lead">
      Microsoft Store で公開した各バージョンの変更内容です。<br>
      更新は Microsoft Store から自動で配信されます。
    </p>

    <ol class="rel-list">
      {releases.map((r) => (
        <li class="rel-item" data-reveal>
          <div class="rel-meta">
            <span class="rel-ver">v{r.version}</span>
            <time class="rel-date" datetime={r.date}>{r.date}</time>
          </div>
          <ul class="rel-body">
            {r.ja.map((line) => <li>{line}</li>)}
          </ul>
        </li>
      ))}
    </ol>

    <p class="rel-back" data-reveal><a href="/drivedam/">Drive DAM の製品ページへ</a></p>
  </div>
</main>

<footer class="site-foot">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <span class="brand"><img src="/drivedam/assets/app-icon.png" alt="">Drive DAM</span>
        <p>ローカルフォルダでも、オンラインストレージ等でもそのまま使えるデジタルアセット管理。共有フォルダを通して、チームでの画像管理・活用を効率化します。</p>
      </div>
      <div class="foot-col">
        <p class="foot-t">対応ストレージ</p>
        <p class="foot-desc">Google Drive などエクスプローラー上で利用できるオンラインストレージ、社内ファイルサーバー、ローカルフォルダに対応</p>
      </div>
      <div class="foot-col">
        <p class="foot-t">Drive DAM について</p>
        <ul>
          <li><a href="/drivedam/">製品ページ</a></li>
          <li><a href="/drivedam/releases/">更新履歴</a></li>
        </ul>
      </div>
    </div>
    <div class="foot-base">
      <a href="/">© ame_dev</a>
      <a href="/privacy/">プライバシーポリシー</a>
    </div>
  </div>
</footer>

<script is:inline>
(function(){
"use strict";

/* ---------- ハンバーガーメニュー(モバイル。LP と同じ挙動) ---------- */
var burger = document.getElementById("headBurger");
var overlay = document.getElementById("headOverlay");
if(burger && overlay){
  function setMenu(open){
    overlay.classList.toggle("open", open);
    burger.setAttribute("aria-expanded", open ? "true" : "false");
    overlay.setAttribute("aria-hidden", open ? "false" : "true");
    burger.setAttribute("aria-label", open ? "メニューを閉じる" : "メニューを開く");
    document.body.style.overflow = open ? "hidden" : "";
  }
  burger.addEventListener("click", function(){
    setMenu(!overlay.classList.contains("open"));
  });
  overlay.querySelectorAll("a").forEach(function(a){
    a.addEventListener("click", function(){ setMenu(false); });
  });
  document.addEventListener("keydown", function(e){
    if(e.key === "Escape" && overlay.classList.contains("open")) setMenu(false);
  });
}

/* ---------- Reveal(LP の IO 共用エンジンの縮小版) ---------- */
var io = new IntersectionObserver(function(entries){
  entries.forEach(function(en){
    if(!en.isIntersecting) return;
    en.target.classList.add("is-in");
    io.unobserve(en.target);
  });
},{threshold:.2, rootMargin:"0px 0px -6% 0px"});
document.querySelectorAll("[data-reveal],[data-cap]").forEach(function(el){ io.observe(el); });
})();
</script>

</DrivedamLayout>
