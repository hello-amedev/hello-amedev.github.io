<script is:inline>
(function(){
"use strict";
var REDUCE = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

/* ---------- ハンバーガーメニュー(モバイル) ---------- */
var burger = document.getElementById("headBurger");
var overlay = document.getElementById("headOverlay");
if(burger && overlay){
  function setMenu(open){
    overlay.classList.toggle("open", open);
    burger.setAttribute("aria-expanded", open ? "true" : "false");
    overlay.setAttribute("aria-hidden", open ? "false" : "true");
    burger.setAttribute("aria-label", open ? "メニューを閉じる" : "メニューを開く");
    document.body.style.overflow = open ? "hidden" : "";
  }
  burger.addEventListener("click", function(){
    setMenu(!overlay.classList.contains("open"));
  });
  overlay.querySelectorAll("a").forEach(function(a){
    a.addEventListener("click", function(){ setMenu(false); });
  });
  document.addEventListener("keydown", function(e){
    if(e.key === "Escape" && overlay.classList.contains("open")) setMenu(false);
  });
}

/* ---------- FAQ(確定コピー 3.9・5 問) ---------- */
var FAQ = [
["画像ファイルは変更されますか?","いいえ。タグやメモは画像と同じフォルダ内の <code>_dam/</code> に保存し、画像ファイルそのものには手を加えません。"],
["Drive DAMをアンインストールしたら、タグやメモはどうなりますか?","タグ・メモはローカルや共有フォルダ内の <code>_dam</code> フォルダに保存されるため、Drive DAMをアンインストールしてもそのまま残ります。チームメンバーの利用には影響ありません。再インストールしてもう一度フォルダを登録すれば、同じ状態で再開できます。また、設定のエクスポート・インポートを利用すれば、フォルダの登録状態や、ブックマークも復元できます。"],
["共有フォルダのアクセス権がない人にも、タグやメモは見えますか?","見えません。共有フォルダのアクセス権限が、そのままタグ・メモの共有範囲になります。"],
["AI で自動的にタグ付けされますか?","いいえ。タグは手作業で付け、チームで共有して育てる運用です。自動分類による意図しない整理はありません。"],
["Macには対応していますか?","Drive DAMはWindows用アプリです。Macには現在対応していません。生成されたサムネイル・設定ファイルは共有フォルダ上に表示されますが、Drive DAMを利用することはできません。Mac版については、今後リリースされる可能性があります。"],
["サムネイルやタグのデータを完全に削除する方法は?","フォルダを登録しているDrive DAMユーザーが居ない状態で、<code>_dam</code> フォルダおよび <code>_dam_thumbs</code> フォルダを削除してください。フォルダ数が多い場合は、同名フォルダを検索してすべて削除してください。"]
];
var faqList = document.getElementById("faqList");
FAQ.forEach(function(qa){
  var li = document.createElement("li");
  li.className = "faq-item";
  li.innerHTML = '<button class="faq-q" aria-expanded="false"><span>'+qa[0]+
    '</span><span class="faq-x" aria-hidden="true"></span></button>'+
    '<div class="faq-a"><div class="faq-a-in"><p>'+qa[1]+"</p></div></div>";
  li.querySelector(".faq-q").addEventListener("click",function(){
    var open = li.classList.toggle("open");
    this.setAttribute("aria-expanded", open ? "true" : "false");
  });
  faqList.appendChild(li);
});

/* ---------- Reveal エンジン(IO 共用) ---------- */
function ease(t){return 1-Math.pow(1-t,3)}
var io = new IntersectionObserver(function(entries){
  entries.forEach(function(en){
    if(!en.isIntersecting) return;
    var el = en.target;
    el.classList.add("is-in");
    var d = el.querySelector && el.querySelector(".draw"); if(d) d.classList.add("is-in");
    io.unobserve(el);
  });
},{threshold:.3, rootMargin:"0px 0px -8% 0px"});
document.querySelectorAll("[data-reveal],[data-cap],[data-shot],[data-steps],.stage-cap")
  .forEach(function(el){ io.observe(el); });

/* ---------- funcs ナビ(スクロールスパイ) ---------- */
var navLinks = document.querySelectorAll(".funcs-nav a");
if(navLinks.length){
  var byId = {};
  navLinks.forEach(function(a){ byId[a.getAttribute("href").slice(1)] = a; });
  var spy = new IntersectionObserver(function(entries){
    entries.forEach(function(en){
      if(!en.isIntersecting) return;
      navLinks.forEach(function(a){ a.classList.remove("active"); });
      var a = byId[en.target.id]; if(a) a.classList.add("active");
    });
  },{rootMargin:"-35% 0px -55% 0px"});
  document.querySelectorAll(".func").forEach(function(f){ spy.observe(f); });
}

/* ---------- 3 特徴の図解の登場 ---------- */
var illIO = new IntersectionObserver(function(entries){
  entries.forEach(function(en){
    if(!en.isIntersecting) return;
    en.target.classList.add("is-in");
    illIO.unobserve(en.target);
  });
},{threshold:.45});
document.querySelectorAll("[data-ill]").forEach(function(el){ illIO.observe(el); });

/* ---------- ヒーローの光+統合 rAF ---------- */
var hero = document.getElementById("hero");
var light = document.getElementById("heroLight");
var frame = document.getElementById("heroFrame");
var head = document.getElementById("siteHead");
var progress = document.getElementById("progress");
var lx=0, ly=0, ltx=0, lty=0;
var gx=.5, gy=.5, gtx=.5, gty=.5;
var running = false;

function tick(){
  if(!running) return;
  var sy = window.scrollY;
  var max = document.documentElement.scrollHeight - window.innerHeight;
  progress.style.transform = "scaleX("+(max>0? sy/max : 0)+")";
  if(sy>24) head.classList.add("scrolled"); else head.classList.remove("scrolled");

  gx += (gtx-gx)*.1; gy += (gty-gy)*.1;
  if(frame){ frame.style.setProperty("--gx",(gx*100)+"%"); frame.style.setProperty("--gy",(gy*100)+"%"); }

  if(light){
    lx += (ltx-lx)*.06; ly += (lty-ly)*.06;
    var heroH = hero.offsetHeight || 1;
    var p = Math.min(sy/(heroH*.85), 1);
    light.style.opacity = String(1 - p*.82);
    var a = light.firstElementChild;
    if(a){
      a.style.setProperty("--lx", lx.toFixed(1)+"px");
      a.style.setProperty("--ly", (ly - p*60).toFixed(1)+"px");
    }
  }
  requestAnimationFrame(tick);
}
function start(){ if(!running){ running = true; requestAnimationFrame(tick); } }
function stop(){ running = false; }

if(REDUCE){
  window.addEventListener("scroll",function(){
    var sy = window.scrollY;
    var max = document.documentElement.scrollHeight - window.innerHeight;
    progress.style.transform = "scaleX("+(max>0? sy/max : 0)+")";
    if(sy>24) head.classList.add("scrolled"); else head.classList.remove("scrolled");
  },{passive:true});
}else{
  start();
  window.addEventListener("pointermove",function(e){
    var w = window.innerWidth, h = window.innerHeight;
    ltx = (e.clientX/w - .5) * 70;
    lty = (e.clientY/h - .5) * 44;
    if(frame){
      var fr = frame.getBoundingClientRect();
      gtx = Math.min(Math.max((e.clientX-fr.left)/fr.width,0),1);
      gty = Math.min(Math.max((e.clientY-fr.top)/fr.height,0),1);
    }
  },{passive:true});
  document.addEventListener("visibilitychange",function(){
    if(document.hidden) stop(); else start();
  });
}
})();
</script>

