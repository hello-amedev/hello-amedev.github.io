---
// サイト共通ヘッダー。home はハブ（/）へ、製品名はサブパスへ。
const { current, lang = "ja", alt } = Astro.props as {
	current?: "hub" | "drivedam";
	lang?: "ja" | "en" | "zh";
	alt?: Partial<Record<"ja" | "en" | "zh", string>>;
};
const langLabel: Record<"ja" | "en" | "zh", string> = { ja: "日本語", en: "EN", zh: "繁體中文" };
const drivedamHref = lang === "en" ? "/en/drivedam/" : lang === "zh" ? "/zh/drivedam/" : "/drivedam/";
---

<header class="site-header">
	<div class="container site-header__inner">
		<a class="brand" href="/">
			<span class="brand__mark">a</span>
			<span>ame_dev</span>
		</a>
		<nav class="site-nav">
			{lang === "en" ? (
				<>
					<a href={drivedamHref} aria-current={current === "drivedam" ? "page" : undefined}>Drive DAM</a>
					<a href={`${drivedamHref}#price`}>Download</a>
					<a href={`${drivedamHref}#faq`}>FAQ</a>
				</>
			) : lang === "zh" ? (
				<>
					<a href={drivedamHref} aria-current={current === "drivedam" ? "page" : undefined}>Drive DAM</a>
					<a href={`${drivedamHref}#price`}>下載</a>
					<a href={`${drivedamHref}#faq`}>常見問題</a>
				</>
			) : (
				<>
					<a href={drivedamHref} aria-current={current === "drivedam" ? "page" : undefined}>Drive DAM</a>
					<a href="/#products">製品</a>
					<a href={`${drivedamHref}#price`}>ダウンロード</a>
					<a href={`${drivedamHref}#faq`}>FAQ</a>
				</>
			)}
			{alt && Object.entries(alt).map(([code, href]) => (
				<a href={`${href}?lang=${code}`}>{langLabel[code as "ja" | "en" | "zh"]}</a>
			))}
		</nav>
	</div>
</header>
