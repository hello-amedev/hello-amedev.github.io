---
// サイト共通ヘッダー。home はハブ（/）へ、製品名はサブパスへ。
const { current, lang = "ja", altHref } = Astro.props as {
	current?: "hub" | "drivedam";
	lang?: "ja" | "en";
	altHref?: string;
};
const isEn = lang === "en";
---

<header class="site-header">
	<div class="container site-header__inner">
		<a class="brand" href="/">
			<span class="brand__mark">a</span>
			<span>ame_dev</span>
		</a>
		<nav class="site-nav">
			{isEn ? (
				<>
					<a href="/en/drivedam/" aria-current={current === "drivedam" ? "page" : undefined}>Drive DAM</a>
					<a href="/en/drivedam/#price">Download</a>
					<a href="/en/drivedam/#faq">FAQ</a>
				</>
			) : (
				<>
					<a href="/drivedam/" aria-current={current === "drivedam" ? "page" : undefined}>Drive DAM</a>
					<a href="/#products">製品</a>
					<a href="/drivedam/#price">ダウンロード</a>
					<a href="/drivedam/#faq">FAQ</a>
				</>
			)}
			{altHref && (
				isEn
					? <a href={`${altHref}?lang=ja`}>日本語</a>
					: <a href={`${altHref}?lang=en`}>EN</a>
			)}
		</nav>
	</div>
</header>
