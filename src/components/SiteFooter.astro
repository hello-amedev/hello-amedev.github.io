---
// サイト共通フッター。問い合わせ・他製品（将来ハブ）・プライバシーポリシー。
const { lang = "ja" } = Astro.props as { lang?: "ja" | "en" };
const isEn = lang === "en";
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container">
		<div class="footer-grid">
			<div class="footer-brand">
				<div class="footer-brand__name">ame_dev</div>
				<p class="footer-brand__desc">
					{isEn
						? "Building small tools that make a small team's work a little lighter."
						: "小さなチームの仕事を、すこし軽くする道具をつくっています。"}
				</p>
			</div>
			<div class="footer-col">
				<h4>{isEn ? "Products" : "製品"}</h4>
				<ul>
					<li><a href={isEn ? "/en/drivedam/" : "/drivedam/"}>Drive DAM</a></li>
					<li><span class="footer-muted">{isEn ? "More to come" : "ほか順次公開"}</span></li>
				</ul>
			</div>
			<div class="footer-col">
				<h4>{isEn ? "Support" : "サポート"}</h4>
				<ul>
					<li><a href="mailto:amemitai@gmail.com">{isEn ? "Contact" : "お問い合わせ"}</a></li>
					<li><a href={isEn ? "/en/privacy/" : "/privacy/"}>{isEn ? "Privacy Policy" : "プライバシーポリシー"}</a></li>
				</ul>
			</div>
		</div>
		<div class="footer-bottom">
			<span>© {year} ame_dev</span>
			<span>Made in Japan</span>
		</div>
	</div>
</footer>
